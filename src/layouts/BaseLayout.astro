---
import '../styles/global.css';
import Header from '../components/Header.astro';
import ArtCallBar from '../components/ArtCallBar.astro';
import { url } from '../lib/url';
import { LANGS, localized, unlocalized, useI18n } from '../i18n';
import { repoUrl } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Cor de fundo da página (temas de sociedade). */
  bodyBg?: string;
}

const { t, u } = useI18n(Astro.url);
const { title, description = t.meta.description, bodyBg } = Astro.props;
const fullTitle = title ? `${title} · Forces of Nature` : t.meta.siteTitle;
const route = unlocalized(Astro.url.pathname);
const alt = (l: (typeof LANGS)[number]) => new URL(url(localized(l, route)), Astro.site).href;
---

<!doctype html>
<html lang={t.meta.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const m = localStorage.getItem('mode');
        if (m === 'dark' || m === 'light') document.documentElement.dataset.mode = m;
        if (localStorage.getItem('artBar') === 'off') document.documentElement.dataset.artbar = 'off';
      } catch {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {
      route !== '/404' && (
        <>
          {LANGS.map((l) => <link rel="alternate" hreflang={l} href={alt(l)} />)}
          <link rel="alternate" hreflang="x-default" href={alt('pt')} />
        </>
      )
    }
  </head>
  <body style={bodyBg ? `background:${bodyBg}` : undefined}>
    <ArtCallBar />
    <Header />
    <slot />
    <footer class="site-footer">
      <span>FORCES OF NATURE RPG</span>
      <span>
        <a href={u('/artes')}>{t.footer.artists}</a> · <a href={repoUrl}>GITHUB</a> · {t.footer.license}
      </span>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    border-top: 1px solid var(--ink);
    background: var(--paper);
    padding: 16px var(--pad-x);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font: 500 10px var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .site-footer a {
    color: inherit;
  }
  .site-footer a:hover {
    color: var(--accent);
  }
</style>
