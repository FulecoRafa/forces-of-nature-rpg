---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NatureSpecimen from '../../components/NatureSpecimen.astro';
import NatureName from '../../components/NatureName.astro';
import AiBadge from '../../components/AiBadge.astro';
import { getNatureMap, getNatures, groupLabel, natColor, natColorDark, natureNumber } from '../../lib/natures';
import { getSocieties } from '../../lib/content';
import { langPaths, useI18n } from '../../i18n';
import { artContactUrl } from '../../data/site';

export const getStaticPaths = langPaths;

const { lang, t, u } = useI18n(Astro.url);
const natures = await getNatures(lang);
const byId = await getNatureMap(lang);
const societies = await getSocieties(lang);
const [featured, ...others] = societies;
---

<BaseLayout>
  <main>
    <section class="hero rule-b">
      <div class="reg" aria-hidden="true">
        <div><span>{t.home.reg[0]}</span><span>{t.home.reg[1]}</span></div>
        <div><span>{t.home.reg[2]}</span><span>{t.home.reg[3]}</span></div>
      </div>
      <div class="ring r1" aria-hidden="true"></div>
      <div class="ring r2" aria-hidden="true"></div>
      <div class="orbit">
        <svg viewBox="0 0 400 400" aria-hidden="true">
          <defs><path id="orb" d="M200,200 m-178,0 a178,178 0 1,1 356,0 a178,178 0 1,1 -356,0"></path></defs>
          <circle cx="200" cy="200" r="194" fill="none" style="stroke:var(--ink)" stroke-width="0.6"></circle>
          <text font-family="Geist Mono, monospace" font-size="11.5" font-weight="500" letter-spacing="3">
            <textPath href="#orb" startOffset="1%">
              {
                natures.map((n, i) => (
                  <>
                    <tspan style={`fill:${natColor(n.hue)}`}>{n.name.toUpperCase()}</tspan>
                    <tspan style="fill:var(--muted-2)">{i === natures.length - 1 ? ' ·' : ' · '}</tspan>
                  </>
                ))
              }
            </textPath>
          </text>
        </svg>
        <div class="disc">
          <h1>Forces<br />of Nature</h1>
        </div>
      </div>
      <p class="intro">{t.home.intro}</p>
      <div class="ctas">
        <a class="btn" href={u('/ficha')}>{t.home.ctaSheet}</a>
        <a class="btn ghost" href={u('/naturezas/gravidade')}>{t.home.ctaNatures}</a>
      </div>
    </section>

    <section class="section rule-b">
      <div class="section-head" style="margin-bottom:28px">
        <h2 class="h2">{t.home.naturesTitle}</h2>
        <span class="label">{t.home.naturesHint}</span>
      </div>
      <div class="cells tiles">
        {
          natures.map((n, i) => (
            <a class="tile plain spec-host" href={u(`/naturezas/${n.id}`)} style={`--c:${natColor(n.hue)};--c-08:${natColor(n.hue, 0.08)}`}>
              <span class="bar" />
              <span class="meta">
                <span>{natureNumber(i)}</span>
                <span>{groupLabel(n.group, lang)}</span>
              </span>
              <NatureSpecimen nature={n} />
              <span class="body">
                <span class="title">
                  <span class="sym">{n.symbol}</span>
                  <NatureName nature={n} size="21px" />
                </span>
                <span class="short">{n.short}</span>
              </span>
            </a>
          ))
        }
        <div class="tile new">
          <span class="meta"><span>{t.home.newNatureMeta}</span></span>
          <span class="body">
            <span class="title"><span class="new-name">{t.home.newNature}</span></span>
            <span class="short muted">{t.home.newNatureText}</span>
          </span>
        </div>
      </div>
    </section>

    <section class="ways rule-b">
      <div class="way organic">
        <span class="kicker">{t.home.organic.kicker}</span>
        <h3>{t.home.organic.title}</h3>
        <p>{t.home.organic.text}</p>
        <span class="tag solid" style="--tag-bg:var(--accent)">{t.home.organic.cost}</span>
      </div>
      <div class="way machine">
        <span class="kicker">{t.home.machine.kicker}</span>
        <h3>{t.home.machine.title}</h3>
        <p>{t.home.machine.text}</p>
        <span class="tag">{t.home.machine.cost}</span>
      </div>
    </section>

    <section class="section socs">
      <div class="section-head">
        <h2 class="h2">{t.home.societiesTitle}</h2>
        <a class="label" href={u('/sociedades')}>{t.home.allSocieties}</a>
      </div>
      {
        featured && (
          <a class="soc-big plain" href={u(`/sociedades/${featured.slug}`)} data-theme={featured.data.theme}>
            <div class="soc-big-text">
              <div class="soc-meta">
                <span>{featured.data.code}</span>
                <span>{featured.data.kind.toUpperCase()}</span>
                <span style={`color:${natColorDark(byId[featured.data.nature].hue)}`}>
                  {byId[featured.data.nature].symbol} · {byId[featured.data.nature].name.toUpperCase()}
                </span>
              </div>
              <div class="soc-big-title">
                <span class="name">{featured.data.title}</span>
                <span class="sum">{featured.data.cardSummary}</span>
              </div>
            </div>
            <div class="soc-big-img">
              {featured.data.heroImage && (
                <>
                  <Image src={featured.data.heroImage} alt="" widths={[480, 960]} sizes="(min-width: 760px) 50vw, 100vw" class="cover" />
                  <AiBadge src={featured.data.heroImage} link={false} />
                </>
              )}
            </div>
          </a>
        )
      }
      <div class="soc-row">
        {
          others.map((s) => {
            const n = byId[s.data.nature];
            return (
              <a class="soc-card plain" href={u(`/sociedades/${s.slug}`)} data-theme={s.data.theme}>
                {s.data.theme === 'silence' && (
                  <>
                    <span class="thr" style="left:22%;height:70%" />
                    <span class="thr" style="left:48%;height:45%" />
                    <span class="thr" style="left:71%;height:85%" />
                  </>
                )}
                <span class="soc-meta">
                  <span>{s.data.code} · {s.data.kind.toUpperCase()}</span>
                  <span style={`color:${natColor(n.hue)}`}>{n.symbol} · {n.name.toUpperCase()}</span>
                </span>
                <span class="soc-card-title">
                  <span class="name">{s.data.title}</span>
                  <span class="sum">{s.data.cardSummary}</span>
                </span>
              </a>
            );
          })
        }
        <a class="soc-card soon plain" href={u('/sociedades')}>
          <span class="label" style="color:inherit">SOC-{String(societies.length + 1).padStart(2, '0')} · {t.common.inWriting}</span>
          <span class="soon-title">{t.home.soonTitle}</span>
        </a>
      </div>
    </section>

    <section class="art-call">
      <div class="art-call-text">
        <span class="kicker">{t.ai.homeKicker}</span>
        <h2>{t.ai.homeTitle}</h2>
        <p>{t.ai.homeText}</p>
        <div class="ctas">
          <a class="btn" href={artContactUrl(lang)}>{t.ai.homeCta}</a>
          <a class="btn ghost" href={u('/artes')}>{t.ai.homeAlt}</a>
        </div>
      </div>
      <a class="art-call-frame plain" href={u('/artes')} aria-hidden="true" tabindex="-1">
        <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
        <span class="frame-label">{t.art.kicker[1]}</span>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .art-call {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: stretch;
    padding: clamp(40px, 6vw, 80px) var(--pad-x);
    border-top: 1px solid var(--ink);
    border-bottom: 6px solid var(--accent);
    background: color-mix(in oklab, var(--accent) 7%, var(--paper));
  }
  .art-call .kicker {
    font: 600 11px var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .art-call h2 {
    margin: 14px 0 16px;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 600;
  }
  .art-call p {
    max-width: 56ch;
    margin: 0 0 28px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2, var(--ink));
  }
  .art-call .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .art-call-frame {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 220px;
    border: 1.5px dashed var(--accent);
    color: var(--accent);
  }
  .art-call-frame:hover {
    background: color-mix(in oklab, var(--accent) 8%, transparent);
  }
  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 2px solid var(--accent);
  }
  .tl { top: -2px; left: -2px; border-right: 0; border-bottom: 0; }
  .tr { top: -2px; right: -2px; border-left: 0; border-bottom: 0; }
  .bl { bottom: -2px; left: -2px; border-right: 0; border-top: 0; }
  .br { bottom: -2px; right: -2px; border-left: 0; border-top: 0; }
  .frame-label {
    font: 500 10px var(--font-mono);
    letter-spacing: 0.08em;
    text-align: center;
    padding: 0 16px;
  }
  @media (max-width: 760px) {
    .art-call {
      grid-template-columns: 1fr;
    }
    .art-call-frame {
      min-height: 120px;
    }
  }
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(32px, 6vw, 72px) 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }
  .reg {
    position: absolute;
    inset: 16px;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font: 500 10px var(--font-mono);
    color: var(--muted);
    letter-spacing: 0.06em;
  }
  .reg > div {
    display: flex;
    justify-content: space-between;
  }
  .ring {
    position: absolute;
    top: 44%;
    left: 50%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    pointer-events: none;
  }
  .r1 {
    width: min(150vw, 1400px);
    border: 1px solid var(--rule-soft);
  }
  .r2 {
    width: min(112vw, 1000px);
    border: 1px dashed var(--rule-2);
  }
  .orbit {
    position: relative;
    width: min(88vw, 580px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .orbit svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .disc {
    width: 68%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--void);
    box-shadow:
      0 0 0 3px var(--paper),
      0 0 0 4px var(--accent),
      0 30px 80px -20px rgba(194, 70, 42, 0.45);
    display: grid;
    place-items: center;
  }
  .disc h1 {
    margin: 0;
    text-align: center;
    color: #f2f0ea;
    font-weight: 500;
    font-size: clamp(34px, 6.4vw, 68px);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  .intro {
    position: relative;
    margin: 0;
    max-width: 32em;
    text-align: center;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .ctas {
    position: relative;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .tiles {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  .tile {
    position: relative;
    padding: 20px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-height: 200px;
    transition: background 0.4s;
  }
  .tile.spec-host:hover,
  .tile.spec-host:focus-visible {
    background: var(--c-08);
  }
  .tile.new {
    justify-content: space-between;
    padding: 18px;
    background: var(--stripes);
  }
  .bar {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 4px;
    background: var(--c);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font: 500 10px var(--font-mono);
    color: var(--muted);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .title {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .sym {
    font: 500 13px var(--font-mono);
    color: var(--c);
  }
  .short {
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-3);
  }
  .short.muted {
    color: var(--muted-2);
  }
  .new-name {
    font-size: 21px;
    color: var(--muted);
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
  }
  .way {
    padding: clamp(28px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 260px;
    justify-content: flex-end;
  }
  .way.organic {
    border-right: 1px solid var(--ink);
    background: linear-gradient(180deg, transparent, rgba(194, 70, 42, 0.08));
  }
  .way.machine {
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--ink) 5%, transparent));
  }
  .kicker {
    font: 500 11px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .organic .kicker {
    color: var(--accent);
  }
  .way h3 {
    margin: 0;
    font-weight: 500;
    font-size: 30px;
    letter-spacing: -0.025em;
  }
  .way p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 32em;
  }
  .way .tag {
    align-self: flex-start;
  }

  .socs {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .soc-meta {
    position: relative;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    font: 500 11px var(--font-mono);
    color: var(--t-label);
  }
  .soc-big {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    background: var(--t-bg);
    color: var(--t-fg);
    min-height: 320px;
  }
  .soc-big:hover,
  .soc-big:focus-visible {
    outline: 2px solid var(--accent);
  }
  .soc-big .soc-meta {
    gap: 16px;
    color: var(--t-accent);
  }
  .soc-big-text {
    padding: clamp(22px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }
  .soc-big-title {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .soc-big-title .name {
    font-weight: 500;
    font-size: clamp(36px, 5vw, 64px);
    letter-spacing: -0.05em;
    line-height: 0.92;
  }
  .soc-big-title .sum {
    font-size: 16px;
    color: var(--t-fg-3);
    max-width: 28em;
  }
  .soc-big-img {
    min-height: 240px;
    background: #000;
    position: relative;
  }
  .soc-big-img :global(img) {
    position: absolute;
    inset: 0;
  }
  .soc-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }
  .soc-card {
    position: relative;
    overflow: hidden;
    background: var(--t-card, var(--t-bg));
    border: 1px solid var(--t-border-2);
    padding: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 200px;
    color: var(--t-fg);
  }
  .soc-card:hover,
  .soc-card:focus-visible {
    border-color: var(--t-fg);
  }
  .thr {
    position: absolute;
    top: 0;
    width: 1px;
    background: linear-gradient(var(--t-border-2), transparent);
  }
  .soc-card-title {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .soc-card-title .name {
    font-weight: var(--t-title-fw);
    font-size: 30px;
    letter-spacing: 0.02em;
  }
  .soc-card-title .sum {
    font-size: 14px;
    color: var(--t-fg-3);
  }
  .soc-card.soon {
    border: 1px dashed var(--muted-2);
    min-height: 130px;
    color: var(--muted);
    background: none;
  }
  .soc-card.soon:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .soon-title {
    font-weight: 500;
    font-size: 22px;
  }
</style>
